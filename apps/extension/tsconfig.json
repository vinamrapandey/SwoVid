{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["@types/chrome"],
    "paths": {
      "@swovid/detection": ["../../packages/detection/src/index.ts"],
      "@swovid/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/detection" },
    { "path": "../../packages/ui" }
  ]
}
